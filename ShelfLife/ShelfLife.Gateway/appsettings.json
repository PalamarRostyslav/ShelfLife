{
  "ReverseProxy": {
    "Routes": {
      "catalogRoute": {
        "ClusterId": "catalogCluster",
        "Match": {
          "Path": "api/books/{**catch-all}"
        }
      },
      "shelvesRoute": {
        "ClusterId": "shelvesCluster",
        "Match": {
          "Path": "api/shelves/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalogCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog.api:8080/"
          }
        }
      },
      "shelvesCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog.api:8080/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
